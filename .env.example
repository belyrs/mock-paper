# Frontend
VITE_API_BASE_URL=http://localhost:4100/api
FRONTEND_PORT=3100

# Backend
NODE_ENV=development
BACKEND_PORT=4100
FRONTEND_URL=http://localhost:3100
APP_BASE_URL=http://localhost:3100
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=auto
TRUST_PROXY_HOPS=0
DATABASE_URL=postgres://mockpaper:mockpaper@localhost:5432/mockpaper
DATABASE_SYNCHRONIZE=false
DATABASE_RUN_MIGRATIONS_ON_START=true
DATABASE_SSL=false
DATABASE_CONNECT_MAX_RETRIES=15
DATABASE_CONNECT_RETRY_DELAY_MS=2000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_URL_PATH=/reset-password
MAIL_PROVIDER=console
MAIL_FROM=no-reply@mockpaper.local
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
QUESTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_REVIEW_MODEL=gpt-5.2
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_GENERATION_REASONING_EFFORT=low
OPENAI_GENERATION_BATCH_SIZE=20
OPENAI_GENERATION_CONCURRENCY=3
OPENAI_REVIEW_REASONING_EFFORT=high
OPENAI_REVIEW_BATCH_SIZE=3
OPENAI_REVIEW_CONCURRENCY=3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEMO_FAST_GENERATION=true
QUESTION_GENERATION_MAX_ATTEMPTS=2
QUESTION_GENERATION_TEMPERATURE=0.4
ACADEMIC_REVIEW_ENABLED=false
SEMANTIC_DEDUP_ENABLED=false
SEMANTIC_SIMILARITY_THRESHOLD=0.92
DEFAULT_ADMIN_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=mockpaper
POSTGRES_USER=mockpaper
POSTGRES_PASSWORD=mockpaper
POSTGRES_PORT=5432
